# =============================================================================
# AI Job Search OS — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

# ---- General ----
TZ=Asia/Kolkata
COMPOSE_PROJECT_NAME=jobsearch-os
LOG_LEVEL=info                       # debug | info | warn | error

# ---- PostgreSQL ----
POSTGRES_USER=jobsearch
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=jobsearch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- n8n ----
# Generate a key with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
# n8n uses the same Postgres instance (separate database below)
N8N_DB_NAME=n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-strong-password

# ---- Ollama (local LLMs) ----
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
# Models are configurable per-purpose so you can trade speed vs quality.
OLLAMA_MODEL_REASONING=llama3.1:8b      # scoring, tailoring, classification, summaries
OLLAMA_MODEL_FAST=llama3.2:3b           # quick/cheap tasks, classification fallback
OLLAMA_MODEL_EMBED=nomic-embed-text     # embeddings for dedup + knowledge base

# ---- ChromaDB (vector store) ----
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_BASE_URL=http://chromadb:8000

# ---- Playwright scraping service ----
PLAYWRIGHT_HOST=playwright-service
PLAYWRIGHT_PORT=4000
PLAYWRIGHT_BASE_URL=http://playwright-service:4000
# Shared secret n8n sends in X-Api-Key to the scraping service.
PLAYWRIGHT_API_KEY=replace-with-a-random-secret
# Respectful scraping defaults
SCRAPE_MIN_DELAY_MS=2500
SCRAPE_MAX_CONCURRENCY=2
SCRAPE_USER_AGENT=JobSearchOS/1.0 (+self-hosted; respectful crawler)
SCRAPE_RESPECT_ROBOTS=true

# ---- Email (Gmail IMAP/SMTP) ----
# Use a Google App Password (requires 2FA), NOT your account password.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=replace-with-app-password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ---- Google Calendar (follow-ups) ----
# Configure OAuth2 inside n8n credentials UI; these are for reference.
GOOGLE_CALENDAR_ID=primary

# ---- Outreach safety / rate limits ----
OUTREACH_REQUIRE_APPROVAL=true
OUTREACH_MAX_PER_DAY=15
OUTREACH_MIN_INTERVAL_MINUTES=10
FOLLOWUP_DEFAULT_DAYS=4

# ---- Scoring thresholds ----
SCORE_MIN_TO_APPLY=70                 # 0-100; below this, job is parked
SCORE_MIN_TO_OUTREACH=80
